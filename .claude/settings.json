{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/git_branch_guard.py\" 2>/dev/null || python \"$CLAUDE_PROJECT_DIR/.claude/hooks/git_branch_guard.py\"",
            "shell": "bash",
            "timeout": 10,
            "statusMessage": "Checking branch rules..."
          }
        ]
      }
    ]
  }
}
