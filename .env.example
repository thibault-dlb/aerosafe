# Copy this file to .env and replace the values. .env is never committed.

# PostgreSQL administrator (used only to create the application database)
POSTGRES_USER=aerosafe_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres

# Application database, read by the API
DB_HOST=postgres
DB_PORT=5432
DB_USER=aerosafe_user
DB_PASS=changeme
DB_NAME=aerosafe_db

# Owner of the application database, used only to run the migrations
DB_MIGRATION_USER=aerosafe_migrator
DB_MIGRATION_PASS=changeme

# Authentication. The JWT secret needs at least 32 characters, and the API refuses to start
# with the value below: replace it with a random one, generated with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=changeme-changeme-changeme-changeme
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
# true in production behind HTTPS; false lets the refresh cookie work over plain HTTP
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_MINUTES=15

# OpenSky collection: variables added by the feat/collection-dashboard work package

# Public URL of the API, as seen from the browser
VITE_API_URL=http://localhost:8888/api
