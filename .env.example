# Copy this file to .env and replace the values. .env is never committed.

# PostgreSQL administrator (used only to create the application database)
POSTGRES_USER=aerosafe_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres

# Application database, read by the API
DB_HOST=postgres
DB_PORT=5432
DB_USER=aerosafe_user
DB_PASS=changeme
DB_NAME=aerosafe_db

# Owner of the application database, used only to run the migrations
DB_MIGRATION_USER=aerosafe_migrator
DB_MIGRATION_PASS=changeme

# Authentication: variables added by the feat/auth-accounts work package

# OpenSky collection: variables added by the feat/collection-dashboard work package
# Only one instance collects with the group account at a time: keep false unless it is yours.
COLLECTION_ENABLED=false
# ILE_DE_FRANCE (every 30 s, 1 credit) or FRANCE (every 120 s, 3 credits)
COLLECTION_PROFILE=ILE_DE_FRANCE
# Maximum gap between two observations of the same flight, in minutes (D-06)
COLLECTION_FLIGHT_GAP_MINUTES=30
# OAuth2 API client of the group account; leave empty for anonymous access (400 credits a day)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# Public URL of the API, as seen from the browser
VITE_API_URL=http://localhost:8888/api
