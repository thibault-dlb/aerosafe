# Copy this file to .env and replace the values. .env is never committed.

# PostgreSQL administrator (used only to create the application database)
POSTGRES_USER=aerosafe_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=postgres

# Application database, read by the API
DB_HOST=postgres
DB_PORT=5432
DB_USER=aerosafe_user
DB_PASS=changeme
DB_NAME=aerosafe_db

# Owner of the application database, used only to run the migrations
DB_MIGRATION_USER=aerosafe_migrator
DB_MIGRATION_PASS=changeme

# Authentication. The JWT secret needs at least 32 characters, and the API refuses to start
# with the value below: replace it with a random one, generated with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_JWT_SECRET=changeme-changeme-changeme-changeme
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
# true in production behind HTTPS; false lets the refresh cookie work over plain HTTP
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_MINUTES=15

# OpenSky collection: variables added by the feat/collection-dashboard work package
# Only one instance collects with the group account at a time: keep false unless it is yours.
COLLECTION_OPENSKY_ENABLED=false
# ILE_DE_FRANCE (every 30 s, 1 credit) or FRANCE (every 120 s, 3 credits)
COLLECTION_PROFILE=ILE_DE_FRANCE
# Maximum gap between two observations of the same flight, in minutes (D-06)
COLLECTION_FLIGHT_GAP_MINUTES=30
# OAuth2 API client of the group account; leave empty for anonymous access (400 credits a day)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# adsb.fi collection, in parallel with OpenSky: no account, one request per second at most.
# About 3.8 GB of observations a day at 250 NM every 5 s; older ones are deleted after the
# retention below (0 keeps everything).
COLLECTION_ADSBFI_ENABLED=false
# Centre of the circle (lat,lon) and its radius in nautical miles, 250 at most
ADSBFI_CENTER=48.65,2.5
ADSBFI_RADIUS_NM=250
ADSBFI_PERIOD_SECONDS=5
ADSBFI_RETENTION_DAYS=7

# Public URL of the API, as seen from the browser
VITE_API_URL=http://localhost:8888/api
